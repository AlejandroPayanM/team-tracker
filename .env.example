# Copia este archivo a .env y completa los valores. NUNCA subas .env a git.

# Base de datos PostgreSQL (local: docker compose up -d; producción: la URL de tu proveedor)
DATABASE_URL="postgresql://tracker:tracker-dev-only@127.0.0.1:5440/tracker"
# Local: la misma URL. En Neon: DATABASE_URL = conexión "pooled" (host con -pooler, termina en ?sslmode=require)
# y DIRECT_URL = conexión directa (sin -pooler); la directa solo se usa para migraciones.
DIRECT_URL="postgresql://tracker:tracker-dev-only@127.0.0.1:5440/tracker"

# ── Seguridad ──
# true en Vercel (pone X-Forwarded-For; se usa para el límite de intentos de login por IP).
# En local déjalo en false.
TRUST_PROXY=false
# Secreto de ≥16 caracteres. Vercel lo envía solo en su cron diario (Authorization: Bearer <CRON_SECRET>)
# a GET /api/cron/sync. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# ── Semanas ──
# Desfase respecto a UTC para calcular inicio de semana (lunes 00:00 local).
# México centro = -360. España invierno = 60.
WEEK_TZ_OFFSET_MINUTES=-360
# Días hacia atrás en la primera sincronización / sincronización completa
SYNC_LOOKBACK_DAYS=120

# ── GitHub ──
# Fine-grained PAT (o classic) con acceso de LECTURA a los repos de la organización:
#   Pull requests: Read, Metadata: Read, Contents: Read
GITHUB_TOKEN=
# Organización a rastrear (recomendado, limita las búsquedas a tu org)
GITHUB_ORG=

# ── Zoho Projects ──
# Data center de tu cuenta: com | eu | in | com.au | jp | ca
ZOHO_DC=com
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
# Refresh token generado con un "Self Client" (ver README)
ZOHO_REFRESH_TOKEN=
ZOHO_PORTAL_ID=
# Opcional: nombre del portal (para armar links a tareas en Zoho)
ZOHO_PORTAL_NAME=
